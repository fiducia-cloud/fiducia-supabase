{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/k8s-libs-and-shared-defs/raw/main/supabase-defs/schemas/contract-lock.schema.json",
  "title": "Supabase GitOps shared-contract lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "coordinate", "source", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "coordinate": { "const": "oresoftware/supabase-gitops-contract" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path", "contractVersion"],
      "properties": {
        "repository": { "const": "https://github.com/ORESoftware/k8s-libs-and-shared-defs.git" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "const": "supabase-defs" },
        "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "localPath", "digestMode", "sha256"],
        "properties": {
          "sourcePath": { "type": "string", "pattern": "^supabase-defs/(?:schemas|src)/[A-Za-z0-9._/-]+$" },
          "localPath": { "type": "string", "pattern": "^(?:schemas|scripts/lib)/[A-Za-z0-9._/-]+$" },
          "digestMode": { "type": "string", "enum": ["raw", "normalized-json-without-id"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
